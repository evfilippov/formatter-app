<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title>Data & Log Formatter</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header>
      <div class="header-inner">
        <div class="brand">⚡ Data & Log Formatter</div>
        <nav>
          <a href="#home">Главная</a>
          <a href="#logs">Логи</a>
          <a href="#json">JSON</a>
          <a href="#xml">XML</a>
          <a href="#graphql">GraphQL</a>
        </nav>
        <div class="limits">Макс. 10 МБ · Тайм-аут 15 c</div>
      </div>
    </header>

    <main>
      <!-- HOME -->
      <section id="home" class="route">
        <h1>Выберите область</h1>
        <div class="cards">
          <div class="card clickable" onclick="navigate('#logs')">
            <h2>📋 Логи</h2>
            <p>
              Извлечение JSON, форматирование и дедупликация. Поиск, фильтрация,
              экспорт и сравнение логов.
            </p>
          </div>
          <div class="card clickable" onclick="navigate('#json')">
            <h2>🔧 JSON</h2>
            <p>
              Pretty / Minify / Validate. Wrap/Unwrap values. Проверка
              целостности.
            </p>
          </div>
          <div class="card clickable" onclick="navigate('#xml')">
            <h2>📄 XML</h2>
            <p>
              Pretty / Minify / Validate. Escape/Unescape для JSON-строки.
              Проверка целостности.
            </p>
          </div>
          <div class="card clickable" onclick="navigate('#graphql')">
            <h2>🔮 GraphQL</h2>
            <p>
              Форматирование, генерация схем, объединение, валидация и
              introspection.
            </p>
          </div>
        </div>
      </section>

      <!-- LOGS -->
      <section id="logs" class="route hidden">
        <h1>📋 Анализ логов</h1>

        <div class="logs-layout">
          <!-- ПАНЕЛЬ РЕЗУЛЬТАТОВ -->
          <div class="logs-results">
            <!-- Toolbar -->
            <div class="logs-toolbar">
              <div class="search-container">
                <input
                  type="text"
                  id="logsSearch"
                  placeholder="🔍 Поиск по сообщениям..."
                />
                <span id="searchCounter" class="search-counter"></span>
              </div>

              <div class="toolbar-actions">
                <select id="logsFilter" class="filter-select">
                  <option value="all">Все типы</option>
                  <option value="request">Request</option>
                  <option value="response">Response</option>
                  <option value="internal">Internal</option>
                  <option value="external">External</option>
                  <option value="info">INFO</option>
                  <option value="debug">DEBUG</option>
                  <option value="error">ERROR</option>
                </select>

                <select id="logsSort" class="filter-select">
                  <option value="number">По номеру</option>
                  <option value="type">По типу</option>
                  <option value="size">По размеру</option>
                  <option value="timestamp">По времени</option>
                </select>

                <div class="btn-group">
                  <button
                    id="btnCollapseAll"
                    class="btn-icon"
                    title="Свернуть все"
                  >
                    <span class="icon">▼</span>
                  </button>
                  <button
                    id="btnExpandAll"
                    class="btn-icon"
                    title="Развернуть все"
                  >
                    <span class="icon">▲</span>
                  </button>
                </div>

                <label class="checkbox-label">
                  <input type="checkbox" id="highlightSearch" checked />
                  Подсветка
                </label>
              </div>
            </div>

            <!-- Статистика -->
            <div id="logsStats" class="stats"></div>

            <!-- Мини-график -->
            <div id="logsChart" class="mini-chart"></div>

            <!-- Кнопки экспорта -->
            <div class="buttons mb8">
              <button id="btnDownload" disabled>📥 Скачать общий отчёт</button>
              <button id="btnCopyExport" disabled>📋 Копировать отчёт</button>
              <button id="btnExportSelected" disabled>
                ✅ Экспорт выбранных
              </button>
              <button id="btnCompare" disabled>🔍 Сравнить (2)</button>
            </div>

            <!-- История поиска -->
            <div id="searchHistory" class="search-history"></div>

            <!-- Результаты -->
            <div id="logsItems" class="logs-items"></div>
          </div>

          <!-- ПАНЕЛЬ ВВОДА -->
          <div class="logs-input">
            <div class="block">
              <label class="label">📁 Файл логов (до 10 МБ):</label>
              <input
                type="file"
                id="logsFile"
                accept=".txt,.log,.json,.ndjson"
              />
              <div id="logsFileInfo" class="hint"></div>
            </div>

            <div class="block">
              <label class="label">📝 Или вставьте текст вручную:</label>
              <textarea
                id="logsInput"
                placeholder="Вставьте логи в формате NDJSON (каждая строка - отдельный JSON объект)..."
              ></textarea>
            </div>

            <div class="block options">
              <div class="opt-group">
                <div class="opt-title">Паттерны извлечения:</div>
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="internalRequest"
                    checked
                  />
                  internalRequest</label
                >
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="externalRequest"
                    checked
                  />
                  externalRequest</label
                >
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="internalResponse"
                    checked
                  />
                  internalResponse</label
                >
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="externalResponse"
                    checked
                  />
                  externalResponse</label
                >
                <label
                  ><input type="checkbox" class="pat" value="request" checked />
                  request</label
                >
                <label
                  ><input type="checkbox" class="pat" value="args" checked />
                  args (для method execution логов)</label
                >
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="response"
                    checked
                  />
                  response</label
                >
                <label
                  ><input
                    type="checkbox"
                    class="pat"
                    value="afterColon"
                    checked
                  />
                  afterColon</label
                >
              </div>

              <div class="opt-group">
                <label
                  ><input type="checkbox" id="replaceEsc" checked /> Заменять \n
                  на переводы строк</label
                >
                <label
                  >Min длина после двоеточия:
                  <input
                    type="number"
                    id="minLen"
                    value="50"
                    min="0"
                    style="width: 90px"
                  />
                </label>
              </div>

              <div class="opt-group">
                <label
                  ><input type="checkbox" id="showOnlyUnique" checked /> Только
                  уникальные</label
                >
                <label
                  ><input type="checkbox" id="showDuplicates" /> Показывать
                  дубликаты</label
                >
                <label
                  ><input type="checkbox" id="autoSave" /> Автосохранение</label
                >
                <label
                  ><input type="checkbox" id="regexMode" /> Regex поиск</label
                >
              </div>
            </div>

            <div class="buttons">
              <button id="btnNormalize" class="btn-primary">
                ⚡ Извлечь и проанализировать
              </button>
              <button id="btnLogsReset" class="secondary">
                🗑️ Очистить всё
              </button>
            </div>

            <div class="hint" style="margin-top: 12px">
              💡 Подсказка: используйте Ctrl+F для быстрого поиска, Ctrl+G для
              перехода к сообщению
            </div>
          </div>
        </div>
      </section>

      <!-- JSON -->
      <section id="json" class="route hidden">
        <h1>🔧 JSON Formatter</h1>
        <div class="two-cols">
          <div class="left">
            <div class="block">
              <label class="label">Файл (до 10 МБ):</label>
              <input type="file" id="jsonFile" accept=".json,.txt" />
              <div id="jsonFileInfo" class="hint"></div>
            </div>
            <div class="block">
              <label class="label">Или вставьте текст вручную:</label>
              <textarea
                id="jsonInput"
                placeholder="Вставьте JSON..."
              ></textarea>
            </div>

            <div class="block options" style="margin-bottom: 12px">
              <div class="opt-group">
                <div class="opt-title">🎯 Режим обработки:</div>
                <label style="margin-right: 10px">
                  <input type="radio" name="jsonMode" value="format" checked />
                  Форматирование
                </label>
                <label>
                  <input type="radio" name="jsonMode" value="wrapper" />
                  Value Wrapper
                </label>
              </div>
            </div>

            <div class="buttons" id="formatButtons">
              <button id="btnPretty">Pretty</button>
              <button id="btnMinify">Minify</button>
              <button id="btnValidate" class="secondary">Validate</button>
            </div>

            <div class="buttons hidden" id="wrapperButtons">
              <button id="btnWrap" class="btn-primary">📦 Wrap Values</button>
              <button id="btnUnwrap" class="btn-primary">
                📂 Unwrap Values
              </button>
            </div>

            <div class="hint" style="margin-top: 12px">
              💡
              <span id="jsonModeHint"
                >Pretty форматирует с отступами, Minify убирает пробелы</span
              >
            </div>
          </div>
          <div class="right">
            <div id="jsonOutput" class="output"></div>
            <div id="jsonStats" class="stats"></div>
            <div id="jsonIntegrity" class="hint"></div>
            <div id="jsonErrors" class="errors"></div>
            <div class="buttons">
              <button id="btnCopyJson" disabled>Копировать результат</button>
              <button id="btnDownloadJson" disabled>Скачать result.json</button>
            </div>
          </div>
        </div>
      </section>

      <!-- XML -->
      <section id="xml" class="route hidden">
        <h1>📄 XML Formatter</h1>
        <div class="two-cols">
          <div class="left">
            <div class="block">
              <label class="label">Файл (до 10 МБ):</label>
              <input type="file" id="xmlFile" accept=".xml,.txt" />
              <div id="xmlFileInfo" class="hint"></div>
            </div>
            <div class="block">
              <label class="label">Или вставьте текст вручную:</label>
              <textarea
                id="xmlInput"
                placeholder="Вставьте XML или XML в виде JSON-строки..."
              ></textarea>
            </div>
            <div class="block options">
              <div class="opt-group">
                <label
                  ><input type="checkbox" id="xmlUnescape" /> Unescape из
                  JSON-строки</label
                >
                <label
                  ><input type="checkbox" id="xmlKeepDecl" checked /> Сохранить
                  XML декларацию</label
                >
                <label
                  ><input type="checkbox" id="xmlEscape" checked /> Escape для
                  JSON-строки</label
                >
              </div>
            </div>
            <div class="buttons">
              <button id="btnXmlPretty">Pretty</button>
              <button id="btnXmlMinify">Minify</button>
              <button id="btnXmlValidate" class="secondary">Validate</button>
            </div>
          </div>
          <div class="right">
            <div id="xmlOutput" class="output"></div>
            <div id="xmlStats" class="stats"></div>
            <div id="xmlIntegrity" class="hint"></div>
            <div id="xmlErrors" class="errors"></div>
            <div class="buttons">
              <button id="btnCopyXml" disabled>Копировать результат</button>
              <button id="btnDownloadXml" disabled>Скачать result.xml</button>
            </div>
          </div>
        </div>
      </section>

      <!-- GRAPHQL SECTION - НАЧАЛО -->
      <section id="graphql" class="route hidden">
        <h1>🔮 GraphQL Formatter & Schema Builder</h1>

        <div class="graphql-tabs">
          <button class="tab-btn active" data-tab="format">📝 Format</button>
          <button class="tab-btn" data-tab="schema">🔧 Schema Generator</button>
          <button class="tab-btn" data-tab="merge">🔀 Merge</button>
          <button class="tab-btn" data-tab="validate">✅ Validate</button>
          <button class="tab-btn" data-tab="introspect">🔍 Introspect</button>
          <button class="tab-btn" data-tab="builder">🏗️ Query Builder</button>
        </div>

        <div id="format-tab" class="graphql-tab-content active">
          <div class="graphql-split">
            <div class="graphql-input-panel">
              <div class="graphql-toolbar">
                <label class="file-upload-btn">
                  📁 Load File
                  <input
                    type="file"
                    id="graphqlFile"
                    accept=".graphql,.gql"
                    style="display: none"
                  />
                </label>
                <button onclick="pasteGraphQL()" class="btn-tool">
                  📋 Paste
                </button>
                <button onclick="clearGraphQL()" class="btn-tool">
                  🗑️ Clear
                </button>
                <label class="checkbox-inline">
                  <input type="checkbox" id="realTimePreview" checked />
                  Real-time
                </label>
                <select id="formatStyle" onchange="handleGraphQLInput()">
                  <option value="compact">Compact {value}</option>
                  <option value="expanded">Expanded</option>
                </select>
              </div>
              <div class="editor-container">
                <div class="line-numbers" id="lineNumbers"></div>
                <textarea
                  id="graphqlInput"
                  class="code-editor"
                  placeholder="Enter GraphQL query/mutation..."
                  spellcheck="false"
                  oninput="handleGraphQLInput()"
                  onscroll="syncScroll('input')"
                >
mutation CreateUser {
  createUser(input: {name: {value: "John"}, age: {value: 30}}) {
    id
    name
    createdAt
  }
}</textarea
                >
              </div>
            </div>

            <div class="graphql-output-panel">
              <div class="graphql-toolbar">
                <span class="status-indicator" id="formatStatus">✅ Ready</span>
                <button onclick="copyGraphQL()" class="btn-tool">
                  📋 Copy
                </button>
                <button onclick="downloadGraphQL()" class="btn-tool">
                  💾 Save
                </button>
                <button onclick="shareGraphQL()" class="btn-tool">
                  🔗 Share
                </button>
              </div>
              <pre
                id="graphqlOutput"
                class="code-output"
                onscroll="syncScroll('output')"
              ></pre>
            </div>
          </div>
        </div>

        <div id="schema-tab" class="graphql-tab-content">
          <div class="graphql-split">
            <div class="graphql-input-panel">
              <div class="graphql-toolbar">
                <h3>Query/Mutation → Schema</h3>
                <button onclick="loadExampleQuery()" class="btn-tool">
                  📝 Example
                </button>
              </div>
              <textarea
                id="queryForSchema"
                class="code-editor"
                placeholder="Paste GraphQL query to generate schema..."
                oninput="handleSchemaGenInput()"
              ></textarea>
            </div>

            <div class="graphql-output-panel">
              <div class="graphql-toolbar">
                <h3>Generated Schema</h3>
                <button onclick="copySchema()" class="btn-tool">📋 Copy</button>
                <button onclick="downloadSchema()" class="btn-tool">
                  💾 Save
                </button>
              </div>
              <pre id="schemaOutput" class="code-output"></pre>
            </div>
          </div>
        </div>

        <div id="merge-tab" class="graphql-tab-content">
          <div class="merge-container">
            <div class="merge-inputs" id="mergeInputsContainer">
              <div class="merge-input-box">
                <div class="merge-header">
                  <h4>Schema/Query 1</h4>
                  <button onclick="clearMergeInput(0)" class="btn-small">
                    Clear
                  </button>
                </div>
                <textarea
                  id="mergeInput0"
                  class="code-editor merge-textarea"
                  placeholder="First schema or query..."
                ></textarea>
              </div>
              <div class="merge-input-box">
                <div class="merge-header">
                  <h4>Schema/Query 2</h4>
                  <button onclick="clearMergeInput(1)" class="btn-small">
                    Clear
                  </button>
                </div>
                <textarea
                  id="mergeInput1"
                  class="code-editor merge-textarea"
                  placeholder="Second schema or query..."
                ></textarea>
              </div>
            </div>

            <div class="merge-controls">
              <button onclick="addMergeInput()" class="btn-secondary">
                ➕ Add Another
              </button>
              <select id="mergeStrategy">
                <option value="auto">Auto Merge</option>
                <option value="keep_first">Keep First on Conflict</option>
                <option value="keep_last">Keep Last on Conflict</option>
                <option value="interactive">Interactive Resolution</option>
              </select>
              <button onclick="performMerge()" class="btn-primary">
                🔀 Merge All
              </button>
            </div>

            <div id="mergeConflicts" class="conflicts-panel hidden">
              <h4>⚠️ Conflicts Detected</h4>
              <div id="conflictsList"></div>
            </div>

            <div class="merge-output">
              <div class="graphql-toolbar">
                <h4>Merged Result</h4>
                <span id="mergeStats" class="stats-text"></span>
                <button onclick="copyMerged()" class="btn-tool">📋 Copy</button>
              </div>
              <pre id="mergeOutput" class="code-output"></pre>
            </div>
          </div>
        </div>

        <div id="validate-tab" class="graphql-tab-content">
          <div class="validate-container">
            <div class="validate-inputs">
              <div class="validate-schema">
                <h4>Schema</h4>
                <textarea
                  id="validateSchema"
                  class="code-editor"
                  placeholder="Enter or paste GraphQL schema..."
                ></textarea>
              </div>
              <div class="validate-query">
                <h4>Query/Mutation</h4>
                <textarea
                  id="validateQuery"
                  class="code-editor"
                  placeholder="Enter query to validate..."
                ></textarea>
              </div>
            </div>

            <div class="validate-controls">
              <button onclick="performValidation()" class="btn-primary">
                ✅ Validate
              </button>
            </div>

            <div id="validationResult" class="validation-result"></div>
          </div>
        </div>

        <div id="introspect-tab" class="graphql-tab-content">
          <div class="introspect-container">
            <div class="introspect-form">
              <h3>🔍 Introspect GraphQL Endpoint</h3>

              <div class="form-group">
                <label>Endpoint URL:</label>
                <input
                  type="text"
                  id="introspectUrl"
                  placeholder="https://api.example.com/graphql"
                  class="form-input"
                />
              </div>

              <div class="form-group">
                <label>Headers (JSON format):</label>
                <textarea
                  id="introspectHeaders"
                  class="form-textarea"
                  placeholder='{"Authorization": "Bearer token", "Content-Type": "application/json"}'
                  rows="3"
                ></textarea>
              </div>

              <div class="form-group">
                <label class="checkbox-label">
                  <input type="checkbox" id="includeDeprecated" checked />
                  Include deprecated fields
                </label>
              </div>

              <button onclick="performIntrospection()" class="btn-primary">
                🔍 Introspect
              </button>
            </div>

            <div class="introspect-output">
              <div class="graphql-toolbar">
                <h4>Introspected Schema</h4>
                <span id="introspectStatus"></span>
                <button onclick="copyIntrospected()" class="btn-tool" disabled>
                  📋 Copy
                </button>
                <button onclick="saveIntrospected()" class="btn-tool" disabled>
                  💾 Save
                </button>
              </div>
              <pre id="introspectOutput" class="code-output"></pre>
            </div>
          </div>
        </div>

        <div id="builder-tab" class="graphql-tab-content">
          <div class="builder-container">
            <div class="builder-schema">
              <h4>Schema Explorer</h4>
              <div id="schemaTree" class="schema-tree"></div>
            </div>

            <div class="builder-canvas">
              <h4>Query Builder</h4>
              <div id="queryCanvas" class="query-canvas">
                <div class="query-type-selector">
                  <label>
                    <input
                      type="radio"
                      name="queryType"
                      value="query"
                      checked
                    />
                    Query
                  </label>
                  <label>
                    <input type="radio" name="queryType" value="mutation" />
                    Mutation
                  </label>
                </div>
                <div id="queryBuilderArea"></div>
              </div>
            </div>

            <div class="builder-result">
              <h4>Generated Query</h4>
              <pre id="builtQuery" class="code-output"></pre>
              <button onclick="copyBuiltQuery()" class="btn-primary">
                📋 Copy Query
              </button>
            </div>
          </div>
        </div>
      </section>
      <!-- GRAPHQL SECTION - КОНЕЦ -->
    </main>

    <!-- Модальное окно сравнения -->
    <div id="compareModal" class="modal hidden">
      <div class="modal-content">
        <div class="modal-header">
          <h2>🔍 Сравнение сообщений</h2>
          <button class="modal-close" onclick="closeCompareModal()">✕</button>
        </div>
        <div class="modal-body">
          <div class="compare-panels">
            <div class="compare-left">
              <h3 id="compareTitle1"></h3>
              <pre id="compareContent1"></pre>
            </div>
            <div class="compare-right">
              <h3 id="compareTitle2"></h3>
              <pre id="compareContent2"></pre>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="/app.js"></script>
  </body>
</html>
