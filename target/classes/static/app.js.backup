// ============================================
// GRAPHQL СЕКЦИЯ - Полный функционал
// ============================================

// GraphQL модуль с полной функциональностью
const GraphQLModule = (function () {
  // Приватные переменные модуля
  let initialized = false;
  let graphqlDebounceTimer;
  let schemaDebounceTimer;
  let currentMergeInputs = 2;
  let introspectedSchema = null;
  let selectedFields = new Set();

  // Проверка готовности DOM элементов
  function checkElements() {
    return {
      section: document.getElementById("graphql"),
      tabs: document.querySelectorAll(".tab-btn"),
      input: document.getElementById("graphqlInput"),
      output: document.getElementById("graphqlOutput"),
      formatTab: document.getElementById("format-tab"),
    };
  }

  // Инициализация модуля
  function init() {
    if (initialized) return;

    const elements = checkElements();
    if (!elements.section) {
      console.warn("GraphQL: Section not found");
      return;
    }

    console.log("🚀 GraphQL Module: Initializing...");

    // Привязка обработчиков табов
    elements.tabs.forEach((btn) => {
      btn.removeEventListener("click", handleTabSwitch); // Удаляем старые
      btn.addEventListener("click", handleTabSwitch);
    });

    // Инициализация файлового загрузчика
    const fileInput = document.getElementById("graphqlFile");
    if (fileInput) {
      fileInput.removeEventListener("change", handleFileUpload);
      fileInput.addEventListener("change", handleFileUpload);
    }

    // Привязываем обработчики к textarea
    const graphqlInput = document.getElementById("graphqlInput");
    if (graphqlInput) {
      graphqlInput.removeAttribute("oninput");
      graphqlInput.removeAttribute("onscroll");
      graphqlInput.removeEventListener("input", handleGraphQLInput);
      graphqlInput.removeEventListener("scroll", handleScrollInput);
      graphqlInput.addEventListener("input", handleGraphQLInput);
      graphqlInput.addEventListener("scroll", handleScrollInput);
    }

    // Привязываем обработчик к Schema Generator textarea
    const queryForSchema = document.getElementById("queryForSchema");
    if (queryForSchema) {
      queryForSchema.removeAttribute("oninput");
      queryForSchema.removeEventListener("input", handleSchemaGenInput);
      queryForSchema.addEventListener("input", handleSchemaGenInput);
    }

    // Привязываем обработчик к select для форматирования
    const formatStyle = document.getElementById("formatStyle");
    if (formatStyle) {
      formatStyle.removeAttribute("onchange");
      formatStyle.removeEventListener("change", handleGraphQLInput);
      formatStyle.addEventListener("change", handleGraphQLInput);
    }

    // Инициализация начального состояния
    if (elements.input) {
      updateLineNumbers();
      checkSharedQuery();
    }

    // Загружаем схему для builder
    loadSchemaForBuilder();

    // Показываем первый таб
    const firstTab = document.querySelector(".tab-btn.active");
    if (firstTab) {
      handleTabSwitch({ target: firstTab });
    }

    initialized = true;
    console.log("✅ GraphQL Module: Ready");
  }

  // Обработчик переключения табов
  function handleTabSwitch(e) {
    const tab = e.target.dataset?.tab;
    if (!tab) return;

    console.log(`🔄 Switching to tab: ${tab}`);

    // Убираем активный класс со всех табов и контента
    document
      .querySelectorAll(".tab-btn")
      .forEach((b) => b.classList.remove("active"));
    document.querySelectorAll(".graphql-tab-content").forEach((c) => {
      c.classList.remove("active");
      c.classList.add("hidden");
      c.style.display = "none";
    });

    // Добавляем активный класс выбранным
    e.target.classList.add("active");
    const tabContent = document.getElementById(`${tab}-tab`);
    if (tabContent) {
      tabContent.classList.add("active");
      tabContent.classList.remove("hidden");
      tabContent.style.display = "block";
    }
  }

  // Обработчик скролла
  function handleScrollInput() {
    syncScroll("input");
  }

  // Real-time форматирование
  function handleGraphQLInput() {
    updateLineNumbers();

    const realTimeEnabled = document.getElementById("realTimePreview")?.checked;
    if (!realTimeEnabled) return;

    clearTimeout(graphqlDebounceTimer);
    graphqlDebounceTimer = setTimeout(() => {
      formatGraphQLPreview();
    }, 300);
  }

  async function formatGraphQLPreview() {
    const input = document.getElementById("graphqlInput")?.value;
    const formatStyle =
      document.getElementById("formatStyle")?.value || "compact";

    if (!input?.trim()) {
      const output = document.getElementById("graphqlOutput");
      if (output) output.innerHTML = "";
      updateStatus("Ready", "ready");
      return;
    }

    updateStatus("Formatting...", "processing");

    try {
      const response = await fetch("/api/graphql/format", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          query: input,
          options: {
            compactValueObjects: formatStyle === "compact",
            sortFields: false,
            indentSize: 2,
          },
        }),
      });

      const result = await response.json();

      if (result.success || result.formatted) {
        const highlighted = highlightGraphQL(
          result.result || result.formatted || result.data || result.output
        );
        const output = document.getElementById("graphqlOutput");
        if (output) output.innerHTML = highlighted;
        updateStatus("Formatted", "success");
      } else {
        const output = document.getElementById("graphqlOutput");
        if (output) {
          output.innerHTML = `<span style="color: red;">❌ ${escapeHtml(
            result.message || result.error || "Format error"
          )}</span>`;
        }
        updateStatus("Error", "error");
      }
    } catch (error) {
      console.error("Format error:", error);
      const output = document.getElementById("graphqlOutput");
      if (output) {
        output.innerHTML = `<span style="color: red;">❌ Network error: ${error.message}</span>`;
      }
      updateStatus("Network Error", "error");
    }
  }

  // Подсветка синтаксиса
  function highlightGraphQL(code) {
    if (!code) return "";

    return code
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(
        /\b(query|mutation|subscription|fragment|on|type|input|enum|interface|union|scalar|schema|directive|extends|implements)\b/g,
        '<span style="color: #d73a49; font-weight: bold;">$1</span>'
      )
      .replace(/(\w+)(\s*\()/g, '<span style="color: #6f42c1;">$1</span>$2')
      .replace(
        /(\w+)(\s*:)(?=[^:])/g,
        '<span style="color: #005cc5;">$1</span>$2'
      )
      .replace(/"([^"]*)"/g, '<span style="color: #032f62;">"$1"</span>')
      .replace(/\b(\d+)\b/g, '<span style="color: #005cc5;">$1</span>')
      .replace(/\b(true|false)\b/g, '<span style="color: #d73a49;">$1</span>')
      .replace(/\bnull\b/g, '<span style="color: #d73a49;">null</span>')
      .replace(/#[^\n]*/g, '<span style="color: #6a737d;">$&</span>')
      .replace(
        /\b([A-Z][a-zA-Z]*)\b/g,
        '<span style="color: #e36209;">$1</span>'
      );
  }

  // Номера строк
  function updateLineNumbers() {
    const textarea = document.getElementById("graphqlInput");
    const lineNumbers = document.getElementById("lineNumbers");
    if (!textarea || !lineNumbers) return;

    const lines = textarea.value.split("\n").length;
    const numbers = Array.from({ length: lines }, (_, i) => i + 1).join("\n");
    lineNumbers.textContent = numbers;
  }

  // Синхронизация скролла
  function syncScroll(source) {
    const input = document.getElementById("graphqlInput");
    const output = document.getElementById("graphqlOutput");
    const lineNumbers = document.getElementById("lineNumbers");

    if (source === "input" && input && output && lineNumbers) {
      output.scrollTop = input.scrollTop;
      lineNumbers.scrollTop = input.scrollTop;
    } else if (source === "output" && output && input) {
      input.scrollTop = output.scrollTop;
    }
  }

  // Утилиты
  function updateStatus(message, type = "ready") {
    const statusEl = document.getElementById("formatStatus");
    if (!statusEl) return;

    const icons = {
      ready: "✅",
      processing: "⏳",
      success: "✅",
      error: "❌",
      warning: "⚠️",
    };

    statusEl.textContent = `${icons[type]} ${message}`;
    statusEl.className = `status-indicator ${type}`;
  }

  function escapeHtml(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  // Обработка файлов
  function handleFileUpload(e) {
    const file = e.target.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      const input = document.getElementById("graphqlInput");
      if (input) {
        input.value = event.target.result;
        handleGraphQLInput();
      }
    };
    reader.readAsText(file);
  }

  // Действия с буфером обмена
  function pasteGraphQL() {
    navigator.clipboard
      .readText()
      .then((text) => {
        const input = document.getElementById("graphqlInput");
        if (input) {
          input.value = text;
          handleGraphQLInput();
        }
      })
      .catch((err) => {
        console.error("Failed to read clipboard:", err);
        showNotification("Failed to read clipboard", "error");
      });
  }

  function clearGraphQL() {
    const input = document.getElementById("graphqlInput");
    const output = document.getElementById("graphqlOutput");

    if (input) input.value = "";
    if (output) output.innerHTML = "";
    updateLineNumbers();
  }

  function copyGraphQL() {
    const output = document.getElementById("graphqlOutput");
    if (!output) return;

    navigator.clipboard
      .writeText(output.textContent)
      .then(() => {
        showNotification("Copied to clipboard!");
      })
      .catch((err) => {
        console.error("Failed to copy:", err);
        showNotification("Failed to copy", "error");
      });
  }

  function downloadGraphQL() {
    const output = document.getElementById("graphqlOutput");
    if (!output) return;

    const blob = new Blob([output.textContent], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "formatted.graphql";
    a.click();
    URL.revokeObjectURL(url);
  }

  function shareGraphQL() {
    const output = document.getElementById("graphqlOutput");
    if (!output) return;

    const url = `${window.location.origin}/graphql?q=${encodeURIComponent(
      btoa(output.textContent)
    )}`;
    navigator.clipboard.writeText(url).then(() => {
      showNotification("Share link copied!");
    });
  }
  // Schema Generator
  function handleSchemaGenInput() {
    const realTimeEnabled = document.getElementById("realTimePreview")?.checked;
    if (!realTimeEnabled) return;

    clearTimeout(schemaDebounceTimer);
    schemaDebounceTimer = setTimeout(() => {
      generateSchemaPreview();
    }, 500);
  }

  async function generateSchemaPreview() {
    const input = document.getElementById("queryForSchema")?.value;

    if (!input?.trim()) {
      const output = document.getElementById("schemaOutput");
      if (output) output.innerHTML = "";
      return;
    }

    try {
      const response = await fetch("/api/graphql/query-to-schema", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ query: input }),
      });

      const result = await response.json();
      const output = document.getElementById("schemaOutput");

      if (output) {
        if (result.success || result.schema) {
          output.innerHTML = highlightGraphQL(result.schema || result.result);
        } else {
          output.innerHTML = `<span style="color: red;">❌ ${escapeHtml(
            result.message || "Schema generation failed"
          )}</span>`;
        }
      }
    } catch (error) {
      console.error("Schema generation error:", error);
      const output = document.getElementById("schemaOutput");
      if (output) {
        output.innerHTML = '<span style="color: red;">❌ Network error</span>';
      }
    }
  }

  function loadExampleQuery() {
    const example = `mutation StartUc2 {
  ruGovPfrEcpApsoMckIssuanceBoService_Bf201Service_StartUc2(
    input: {
      mainInfo: {
        claimTypeCode: {value: "1985"},
        fillingDate: {value: "2025-04-02"}
      },
      person: {
        code: {value: "1"},
        personInfo: {
          id: {value: 268386},
          versionId: {value: 310503}
        }
      }
    }
  ) {
    claimId {
      value
    }
    claimNumber {
      value
    }
  }
}`;
    const input = document.getElementById("queryForSchema");
    if (input) {
      input.value = example;
      generateSchemaPreview();
    }
  }

  function copySchema() {
    const output = document.getElementById("schemaOutput");
    if (!output) return;

    navigator.clipboard.writeText(output.textContent).then(() => {
      showNotification("Schema copied to clipboard!");
    });
  }

  function downloadSchema() {
    const output = document.getElementById("schemaOutput");
    if (!output) return;

    const blob = new Blob([output.textContent], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "schema.graphql";
    a.click();
    URL.revokeObjectURL(url);
  }

  // MERGE функции
  async function performMerge() {
    console.log("🔀 Starting merge...");

    const inputs = [];

    // Собираем все непустые textarea
    for (let i = 0; i < 10; i++) {
      const textarea = document.getElementById(`mergeInput${i}`);
      if (textarea && textarea.value.trim()) {
        let normalizedSchema = textarea.value.trim();
        // Автоматически исправляем известные опечатки
        normalizedSchema = normalizedSchema.replace(
          /resultMesage:/g,
          "resultMessage:"
        );
        inputs.push(normalizedSchema);
      }
    }

    if (inputs.length < 2) {
      showNotification(
        "Please provide at least 2 schemas/queries to merge",
        "error"
      );
      return;
    }

    console.log(`📦 Found ${inputs.length} schemas to merge`);

    const strategy = document.getElementById("mergeStrategy")?.value || "auto";
    const mergeOutput = document.getElementById("mergeOutput");

    if (!mergeOutput) return;

    // Предварительный анализ конфликтов
    const conflicts = findConflicts(inputs);
    if (conflicts.length > 0) {
      console.warn("⚠️ Detected potential conflicts:", conflicts);
    }

    try {
      const isSchema =
        inputs[0].includes("type ") || inputs[0].includes("input ");

      // Для схем используем специальный обработчик
      if (isSchema) {
        const localMerged = mergeGraphQLSchemas(inputs, strategy);

        if (localMerged.success) {
          mergeOutput.innerHTML = highlightGraphQL(localMerged.result);

          const stats = document.getElementById("mergeStats");
          if (stats) {
            stats.textContent = `✅ Merged ${inputs.length} schemas (${localMerged.types} types, ${localMerged.inputs} inputs)`;
          }

          if (localMerged.conflicts && localMerged.conflicts.length > 0) {
            showMergeConflicts(
              localMerged.conflicts,
              strategy === "interactive"
            );
          }

          console.log("✅ Local merge successful");
          return;
        }
      }

      // Если локальное слияние не удалось, пробуем серверное
      const endpoint = isSchema
        ? "/api/graphql/merge-schemas"
        : "/api/graphql/merge-queries";

      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          schemas: isSchema ? inputs : undefined,
          queries: !isSchema ? inputs : undefined,
          options: {
            conflictStrategy: strategy,
            autoResolveConflicts: true,
            normalizeTypes: true,
          },
        }),
      });

      const result = await response.json();

      if (result.success || result.mergedSchema || result.schema) {
        const mergedContent =
          result.mergedSchema || result.schema || result.result;
        mergeOutput.innerHTML = highlightGraphQL(mergedContent);

        const stats = document.getElementById("mergeStats");
        if (stats) {
          stats.textContent = `✅ Merged ${inputs.length} inputs successfully`;
        }

        if (result.conflicts && result.conflicts.length > 0) {
          showMergeConflicts(result.conflicts, strategy === "interactive");
        }
      } else {
        mergeOutput.innerHTML = `
          <div style="color: red; padding: 10px;">
            <h4>❌ Merge failed</h4>
            <p>${escapeHtml(result.message || "Unknown error")}</p>
            ${result.details ? `<pre>${escapeHtml(result.details)}</pre>` : ""}
            ${
              conflicts.length > 0
                ? `
              <h5>Detected conflicts:</h5>
              <ul>
                ${conflicts.map((c) => `<li>${escapeHtml(c)}</li>`).join("")}
              </ul>
            `
                : ""
            }
            <h5>Suggestions:</h5>
            <ul>
              <li>Fix duplicate type definitions with different fields</li>
              <li>Rename conflicting types (e.g., ChildInput → ChildInputUc4)</li>
              <li>Use "Keep First on Conflict" strategy</li>
            </ul>
          </div>
        `;
      }
    } catch (error) {
      console.error("Merge error:", error);
      mergeOutput.innerHTML = `
        <div style="color: red; padding: 10px;">
          <h4>❌ Network error</h4>
          <p>${error.message}</p>
          <p>The server might not support schema merging. Try:</p>
          <ul>
            <li>Manually combine the schemas</li>
            <li>Fix conflicting type definitions</li>
            <li>Use a GraphQL schema stitching tool</li>
          </ul>
        </div>
      `;
    }
  }

  // Вспомогательные функции для Merge
  function findConflicts(schemas) {
    const conflicts = [];
    const typeMap = new Map();

    schemas.forEach((schema, schemaIndex) => {
      const typeRegex = /(type|input|enum|interface)\s+(\w+)/g;
      let match;

      while ((match = typeRegex.exec(schema)) !== null) {
        const [, keyword, typeName] = match;

        if (typeMap.has(typeName)) {
          const existing = typeMap.get(typeName);
          const existingBody = extractTypeBody(existing.schema, typeName);
          const currentBody = extractTypeBody(schema, typeName);

          if (existingBody !== currentBody) {
            conflicts.push(
              `Type "${typeName}" defined differently in schema ${
                existing.index + 1
              } and ${schemaIndex + 1}`
            );
          }
        } else {
          typeMap.set(typeName, { schema, index: schemaIndex });
        }
      }
    });

    return conflicts;
  }

  function extractTypeBody(schema, typeName) {
    const regex = new RegExp(
      `(type|input|enum|interface)\\s+${typeName}\\s*\\{([^}]+)\\}`,
      "s"
    );
    const match = schema.match(regex);
    return match ? match[2].trim() : "";
  }

  function mergeGraphQLSchemas(schemas, strategy) {
    try {
      const mergedTypes = new Map();
      const mergedInputs = new Map();
      const mutations = [];
      const queries = [];
      const conflicts = [];

      schemas.forEach((schema, index) => {
        const typeRegex = /type\s+(\w+)\s*\{([^}]+)\}/gs;
        let match;

        while ((match = typeRegex.exec(schema)) !== null) {
          const [fullMatch, typeName, typeBody] = match;

          if (typeName === "Mutation") {
            mutations.push(typeBody.trim());
          } else if (typeName === "Query") {
            queries.push(typeBody.trim());
          } else {
            if (mergedTypes.has(typeName)) {
              const existing = mergedTypes.get(typeName);
              if (existing !== typeBody.trim()) {
                if (strategy === "keep_first") {
                  // Оставляем первый
                } else if (strategy === "keep_last") {
                  mergedTypes.set(typeName, typeBody.trim());
                } else {
                  conflicts.push({
                    typeName,
                    description: `Type ${typeName} has different definitions`,
                    value1: existing,
                    value2: typeBody.trim(),
                  });
                }
              }
            } else {
              mergedTypes.set(typeName, typeBody.trim());
            }
          }
        }

        // Парсим inputs
        const inputRegex = /input\s+(\w+)\s*\{([^}]+)\}/gs;

        while ((match = inputRegex.exec(schema)) !== null) {
          const [fullMatch, inputName, inputBody] = match;

          if (mergedInputs.has(inputName)) {
            const existing = mergedInputs.get(inputName);
            if (existing !== inputBody.trim()) {
              if (strategy === "keep_first") {
                // Оставляем первый
              } else if (strategy === "keep_last") {
                mergedInputs.set(inputName, inputBody.trim());
              } else {
                conflicts.push({
                  typeName: inputName,
                  description: `Input ${inputName} has different definitions`,
                  value1: existing,
                  value2: inputBody.trim(),
                });
              }
            }
          } else {
            mergedInputs.set(inputName, inputBody.trim());
          }
        }
      });

      // Собираем результат
      let result = "";

      if (mutations.length > 0) {
        result += "type Mutation {\n" + mutations.join("\n") + "\n}\n\n";
      }

      if (queries.length > 0) {
        result += "type Query {\n" + queries.join("\n") + "\n}\n\n";
      }

      for (const [typeName, typeBody] of mergedTypes) {
        result += `type ${typeName} {\n${typeBody}\n}\n\n`;
      }

      for (const [inputName, inputBody] of mergedInputs) {
        result += `input ${inputName} {\n${inputBody}\n}\n\n`;
      }

      return {
        success: true,
        result,
        types: mergedTypes.size,
        inputs: mergedInputs.size,
        conflicts,
      };
    } catch (error) {
      console.error("Local merge error:", error);
      return { success: false, error: error.message };
    }
  }

  function showMergeConflicts(conflicts, interactive) {
    const conflictsPanel = document.getElementById("mergeConflicts");
    const conflictsList = document.getElementById("conflictsList");

    if (!conflictsPanel || !conflictsList) return;

    conflictsPanel.classList.remove("hidden");
    conflictsList.innerHTML = "";

    conflicts.forEach((conflict, index) => {
      const conflictItem = document.createElement("div");
      conflictItem.innerHTML = `
        <div style="padding: 10px; border: 1px solid #e0e0e0; margin: 5px 0;">
          <h5>⚠️ Conflict in ${conflict.typeName || "field"}</h5>
          <p>${conflict.description || "Field conflict detected"}</p>
          <div style="background: #f5f5f5; padding: 5px;">
            <div>Option 1: <code>${
              conflict.value1 || conflict.option1 || ""
            }</code></div>
            <div>Option 2: <code>${
              conflict.value2 || conflict.option2 || ""
            }</code></div>
          </div>
        </div>
      `;
      conflictsList.appendChild(conflictItem);
    });
  }

  function addMergeInput() {
    const container = document.getElementById("mergeInputsContainer");
    if (!container) return;

    const existingInputs =
      container.querySelectorAll(".merge-input-box").length;
    const index = existingInputs;

    const newInput = document.createElement("div");
    newInput.className = "merge-input-box";
    newInput.innerHTML = `
      <div class="merge-header">
        <h4>Schema/Query ${index + 1}</h4>
        <button onclick="window.removeMergeInput(${index})" class="btn-small">Remove</button>
      </div>
      <textarea 
        id="mergeInput${index}" 
        class="code-editor merge-textarea"
        placeholder="Additional schema or query..."
        style="min-height: 200px;"
      ></textarea>
    `;

    container.appendChild(newInput);
    console.log(`✅ Added input field ${index + 1}`);
  }

  function removeMergeInput(index) {
    const element = document
      .getElementById(`mergeInput${index}`)
      ?.closest(".merge-input-box");
    if (element) {
      element.remove();
      console.log(`✅ Removed input field ${index}`);
    }
  }

  function clearMergeInput(index) {
    const input = document.getElementById(`mergeInput${index}`);
    if (input) {
      input.value = "";
      console.log(`✅ Cleared input field ${index}`);
    }
  }

  function copyMerged() {
    const output = document.getElementById("mergeOutput");
    if (!output) return;

    navigator.clipboard
      .writeText(output.textContent)
      .then(() => {
        showNotification("Merged schema copied!");
      })
      .catch((err) => {
        console.error("Failed to copy:", err);
        showNotification("Failed to copy", "error");
      });
  }

  // VALIDATE функции
  async function performValidation() {
    const schema = document.getElementById("validateSchema")?.value;
    const query = document.getElementById("validateQuery")?.value;

    if (!schema?.trim() || !query?.trim()) {
      showNotification("Please provide both schema and query", "error");
      return;
    }

    try {
      const response = await fetch("/api/graphql/validate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ schema, query }),
      });

      const result = await response.json();
      const resultDiv = document.getElementById("validationResult");

      if (!resultDiv) return;

      if (result.valid) {
        resultDiv.innerHTML = `
          <div style="padding: 20px; background: #d4edda; color: #155724; border-radius: 4px;">
            <h4>✅ Validation Successful</h4>
            <p>The query is valid according to the schema.</p>
          </div>
        `;
      } else {
        resultDiv.innerHTML = `
          <div style="padding: 20px; background: #f8d7da; color: #721c24; border-radius: 4px;">
            <h4>❌ Validation Failed</h4>
            <ul>
              ${(result.errors || [])
                .map((err) => `<li>${escapeHtml(err)}</li>`)
                .join("")}
            </ul>
          </div>
        `;
      }
    } catch (error) {
      console.error("Validation error:", error);
      showNotification("Validation failed", "error");
    }
  }

  // INTROSPECTION функции
  async function performIntrospection() {
    const url = document.getElementById("introspectUrl")?.value;
    const headersText = document.getElementById("introspectHeaders")?.value;

    if (!url?.trim()) {
      showNotification("Please provide GraphQL endpoint URL", "error");
      return;
    }

    let headers = {};
    if (headersText?.trim()) {
      try {
        headers = JSON.parse(headersText);
      } catch (e) {
        showNotification("Invalid headers JSON format", "error");
        return;
      }
    }

    const statusEl = document.getElementById("introspectStatus");
    if (statusEl) {
      statusEl.textContent = "⏳ Introspecting...";
    }

    try {
      const response = await fetch("/api/graphql/introspect", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          endpoint: url,
          headers: headers,
          includeDeprecated:
            document.getElementById("includeDeprecated")?.checked,
        }),
      });

      const result = await response.json();

      if (result.success || result.schema) {
        introspectedSchema = result.schema;
        const output = document.getElementById("introspectOutput");
        if (output) {
          output.innerHTML = highlightGraphQL(result.schema);
        }

        // Включаем кнопки
        document
          .querySelectorAll("#introspect-tab .btn-tool")
          .forEach((btn) => {
            btn.disabled = false;
          });

        if (statusEl) {
          statusEl.textContent = "✅ Introspection complete";
        }

        showNotification("Schema introspected successfully!");
      } else {
        const output = document.getElementById("introspectOutput");
        if (output) {
          output.innerHTML = `<span style="color: red;">❌ ${escapeHtml(
            result.message || "Introspection failed"
          )}</span>`;
        }

        if (statusEl) {
          statusEl.textContent = "❌ Introspection failed";
        }
      }
    } catch (error) {
      console.error("Introspection error:", error);
      if (statusEl) {
        statusEl.textContent = "❌ Network error";
      }
      showNotification("Introspection failed", "error");
    }
  }

  function copyIntrospected() {
    if (!introspectedSchema) return;

    navigator.clipboard.writeText(introspectedSchema).then(() => {
      showNotification("Schema copied to clipboard!");
    });
  }

  function saveIntrospected() {
    if (!introspectedSchema) return;

    const blob = new Blob([introspectedSchema], { type: "text/plain" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "introspected-schema.graphql";
    a.click();
    URL.revokeObjectURL(url);
  }

  // Query Builder функции
  function loadSchemaForBuilder() {
    const treeEl = document.getElementById("schemaTree");
    if (!treeEl) return;

    treeEl.innerHTML = `
      <div class="schema-node" onclick="window.toggleField('Query')" style="cursor: pointer; padding: 5px;">
        📁 Query
      </div>
      <div class="schema-children" style="margin-left: 20px;">
        <div class="schema-node" onclick="window.selectField('users')" style="cursor: pointer; padding: 5px;">
          👤 users
        </div>
        <div class="schema-node" onclick="window.selectField('posts')" style="cursor: pointer; padding: 5px;">
          📝 posts
        </div>
      </div>
      <div class="schema-node" onclick="window.toggleField('Mutation')" style="cursor: pointer; padding: 5px;">
        📁 Mutation
      </div>
      <div class="schema-children" style="margin-left: 20px;">
        <div class="schema-node" onclick="window.selectField('createUser')" style="cursor: pointer; padding: 5px;">
          ➕ createUser
        </div>
        <div class="schema-node" onclick="window.selectField('updateUser')" style="cursor: pointer; padding: 5px;">
          ✏️ updateUser
        </div>
      </div>
    `;
  }

  function selectField(field) {
    if (selectedFields.has(field)) {
      selectedFields.delete(field);
    } else {
      selectedFields.add(field);
    }
    updateQueryBuilder();
  }

  function updateQueryBuilder() {
    const queryType =
      document.querySelector('input[name="queryType"]:checked')?.value ||
      "query";
    const builtQuery = document.getElementById("builtQuery");

    if (!builtQuery) return;

    let query = `${queryType} MyQuery {\n`;
    selectedFields.forEach((field) => {
      query += `  ${field} {\n    id\n    name\n  }\n`;
    });
    query += "}";

    builtQuery.innerHTML = highlightGraphQL(query);
  }

  function copyBuiltQuery() {
    const query = document.getElementById("builtQuery")?.textContent;
    if (!query) return;

    navigator.clipboard.writeText(query).then(() => {
      showNotification("Query copied to clipboard!");
    });
  }

  function toggleField(fieldName) {
    const children = document.querySelector(
      `.schema-children[data-parent="${fieldName}"]`
    );
    if (children) {
      children.classList.toggle("hidden");
    }
  }

  function checkSharedQuery() {
    const urlParams = new URLSearchParams(window.location.search);
    const sharedQuery = urlParams.get("q");
    if (sharedQuery) {
      try {
        const decoded = atob(sharedQuery);
        const input = document.getElementById("graphqlInput");
        if (input) {
          input.value = decoded;
          handleGraphQLInput();
        }
      } catch (e) {
        console.error("Invalid shared query");
      }
    }
  }

  // Публичный API модуля
  return {
    init: init,
    handleGraphQLInput: handleGraphQLInput,
    pasteGraphQL: pasteGraphQL,
    clearGraphQL: clearGraphQL,
    copyGraphQL: copyGraphQL,
    downloadGraphQL: downloadGraphQL,
    shareGraphQL: shareGraphQL,
    loadExampleQuery: loadExampleQuery,
    copySchema: copySchema,
    downloadSchema: downloadSchema,
    syncScroll: syncScroll,
    selectField: selectField,
    toggleField: toggleField,
    copyBuiltQuery: copyBuiltQuery,
    performMerge: performMerge,
    showMergeConflicts: showMergeConflicts,
    addMergeInput: addMergeInput,
    removeMergeInput: removeMergeInput,
    clearMergeInput: clearMergeInput,
    copyMerged: copyMerged,
    performValidation: performValidation,
    performIntrospection: performIntrospection,
    copyIntrospected: copyIntrospected,
    saveIntrospected: saveIntrospected,
    handleSchemaGenInput: handleSchemaGenInput,
  };
})();

// Инициализация GraphQL при переходе на страницу
window.addEventListener("hashchange", () => {
  if (window.location.hash === "#graphql") {
    setTimeout(() => GraphQLModule.init(), 100);
  }
});

// Инициализация при загрузке
document.addEventListener("DOMContentLoaded", () => {
  if (window.location.hash === "#graphql") {
    setTimeout(() => GraphQLModule.init(), 100);
  }
});

// ============================================
// ЭКСПОРТ GRAPHQL ФУНКЦИЙ В ГЛОБАЛЬНУЮ ОБЛАСТЬ
// ============================================
window.GraphQLModule = GraphQLModule;
window.handleGraphQLInput = () => GraphQLModule.handleGraphQLInput();
window.pasteGraphQL = () => GraphQLModule.pasteGraphQL();
window.clearGraphQL = () => GraphQLModule.clearGraphQL();
window.copyGraphQL = () => GraphQLModule.copyGraphQL();
window.downloadGraphQL = () => GraphQLModule.downloadGraphQL();
window.shareGraphQL = () => GraphQLModule.shareGraphQL();
window.loadExampleQuery = () => GraphQLModule.loadExampleQuery();
window.copySchema = () => GraphQLModule.copySchema();
window.downloadSchema = () => GraphQLModule.downloadSchema();
window.syncScroll = (source) => GraphQLModule.syncScroll(source);
window.selectField = (field) => GraphQLModule.selectField(field);
window.toggleField = (fieldName) => GraphQLModule.toggleField(fieldName);
window.copyBuiltQuery = () => GraphQLModule.copyBuiltQuery();

// Функции для Merge
window.performMerge = () => GraphQLModule.performMerge();
window.addMergeInput = () => GraphQLModule.addMergeInput();
window.removeMergeInput = (index) => GraphQLModule.removeMergeInput(index);
window.clearMergeInput = (index) => GraphQLModule.clearMergeInput(index);
window.copyMerged = () => GraphQLModule.copyMerged();

// Функции для Validate
window.performValidation = () => GraphQLModule.performValidation();

// Функции для Introspect
window.performIntrospection = () => GraphQLModule.performIntrospection();
window.copyIntrospected = () => GraphQLModule.copyIntrospected();
window.saveIntrospected = () => GraphQLModule.saveIntrospected();

// Дополнительный обработчик для Schema Generator
window.handleSchemaGenInput = () => GraphQLModule.handleSchemaGenInput();

console.log("✅ GraphQL модуль полностью загружен и готов к работе!");

// ============================================
// ФИНАЛЬНАЯ ПРОВЕРКА И ИНИЦИАЛИЗАЦИЯ
// ============================================

// Убеждаемся что модуль инициализирован при прямом переходе на #graphql
if (window.location.hash === "#graphql") {
  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(() => {
      console.log("🔄 Повторная инициализация GraphQL...");
      GraphQLModule.init();

      // Убедимся что первый таб активен
      const formatTab = document.getElementById("format-tab");
      if (formatTab && formatTab.style.display === "none") {
        formatTab.style.display = "block";
        formatTab.classList.add("active");
        formatTab.classList.remove("hidden");
      }
    }, 500);
  });
}

